# Copy this file to ".env" and fill in your real key. NEVER commit .env
GOOGLE_API_KEY=your-gemini-key-here

# Optional (only if you switch provider/data source in config.yaml)
ALPHA_VANTAGE_API_KEY=
OPENAI_API_KEY=


# Optional: LangSmith tracing. Keep off when using real portfolio data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-finance-assistant